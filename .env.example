APP_NAME="Clinica Norte - Sistema de Laboratorio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/La_Paz
APP_URL=https://tecnoweb.shop

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ─── Política de contraseñas (config/password_policy.php) ───────────────────
# Longitud y complejidad al crear/cambiar contraseña en admin y portales.
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=12
# PASSWORD_REQUIRE_UPPERCASE=true
# PASSWORD_REQUIRE_LOWERCASE=true
# PASSWORD_REQUIRE_NUMBER=true
# PASSWORD_REQUIRE_SYMBOL=true

# Bloqueo tras intentos fallidos de login (/admin, /paciente/login, /medico/login)
# AUTH_LOGIN_MAX_ATTEMPTS=5
# AUTH_LOGIN_DECAY_SECONDS=600

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Base de datos (MySQL en el VPS) ─────────────────────────────────────────
# Crear BD y usuario en MySQL; usar el usuario que renombraste (antes "marco").
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinica_norte
DB_USERNAME=clinica_norte
DB_PASSWORD=Asdf1234@

# ─── Sesiones, Cache y Colas ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = jobs al instante (bienvenida paciente sin queue:work). database = requiere worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# ─── Correo electrónico (Postfix en el mismo VPS) ─────────────────────────────
# Cuenta: sistema@tecnoweb.shop (passwd en el servidor). Postfix: inet_protocols=ipv4.
# DKIM selector: mail. OpenDKIM socket: /var/spool/postfix/opendkim/opendkim.sock
MAIL_MAILER=smtp
MAIL_HOST=tecnoweb.shop
MAIL_PORT=587
MAIL_USERNAME=sistema@tecnoweb.shop
MAIL_PASSWORD=qwer1234
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=sistema@tecnoweb.shop
MAIL_FROM_NAME="${APP_NAME}"

# ─── Pasarela de pagos Libélula ───────────────────────────────────────────────
LIBELULA_APPKEY=
LIBELULA_API_URL=https://api.libelula.bo

# ─── Datos bancarios para comprobantes ───────────────────────────────────────
CLINIC_TIMEZONE=America/La_Paz
CLINIC_BANK_NAME="Banco Union"
CLINIC_ACCOUNT_HOLDER="Clínica Norte S.R.L."
CLINIC_ACCOUNT_NUMBER=
CLINIC_ACCOUNT_TYPE="Cuenta corriente"
CLINIC_CURRENCY=BOB

# ─── Vite ────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
